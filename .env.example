# Vaidyasala — example env. Copy to .env and fill. NEVER commit .env (LAW 5).
# Dev-safe defaults; secrets stay empty until provisioned.

# ── Core services (dev compose; ports per DECISIONS.md, 127.0.0.1 only) ──
DATABASE_URL=postgresql://vaidyasala:vaidyasala@localhost:55432/vaidyasala?schema=public
REDIS_URL=redis://localhost:56379
NEXT_PUBLIC_SITE_URL=http://localhost:3000

POSTGRES_USER=vaidyasala
POSTGRES_PASSWORD=vaidyasala
POSTGRES_DB=vaidyasala
POSTGRES_PORT=55432
REDIS_PORT=56379
MEILI_PORT=57700
MEILI_MASTER_KEY=devMasterKeyChangeMe0000000000000000

# ── Worker ──
WORKER_CONCURRENCY=4

# ── Object storage (S3-compatible: MinIO in dev, Cloudflare R2 in prod) ──
S3_ENDPOINT=http://localhost:59000
S3_REGION=auto
S3_ACCESS_KEY_ID=vaidyasala
S3_SECRET_ACCESS_KEY=vaidyasala
S3_BUCKET_MEDIA=vaidyasala-media
S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_BASE_URL=            # public CDN base for media (R2 custom domain)
MINIO_PORT=59000
MINIO_CONSOLE_PORT=59001

# ── YouTube (metadata/stats/poll). Absent API key ⇒ yt-dlp keyless metadata fallback ──
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
YT_DLP_PATH=yt-dlp

# ── WebSub webhook (§9.1) ──
WEBSUB_VERIFY_TOKEN=
WEBSUB_SECRET=

# ── Admin ingest RBAC stub (replaced by Better Auth in Phase 2D) ──
ADMIN_INGEST_TOKEN=

# ── AI / external providers (Phase 2C+) ──
ANTHROPIC_API_KEY=
SARVAM_API_KEY=
EMBED_API_KEY=
RESEND_API_KEY=