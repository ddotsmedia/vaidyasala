# Vaidyasala environment (copy to .env — never commit real secrets, LAW 5).
# Names/hosts mirror docs/VARIABLES.md; only real keys go in .env.

# --- Dev infra (infra/docker/compose.dev.yml) ---
POSTGRES_USER=vaidyasala
POSTGRES_PASSWORD=vaidyasala
POSTGRES_DB=vaidyasala
POSTGRES_PORT=55432
REDIS_PORT=56379
MEILI_PORT=57700

# --- App connections ---
DATABASE_URL=postgresql://vaidyasala:vaidyasala@localhost:55432/vaidyasala?schema=public
REDIS_URL=redis://localhost:56379
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Search ---
MEILI_MASTER_KEY=devMasterKeyChangeMe0000000000000000
MEILI_HOST=http://localhost:57700

# --- External services (obtain keys, keep here only in real .env) ---
YOUTUBE_CHANNEL_ID=
YOUTUBE_API_KEY=
ANTHROPIC_API_KEY=
SARVAM_API_KEY=
EMBED_API_KEY=
RESEND_API_KEY=

# --- Cloudflare / R2 (Phase 7) ---
CF_ACCOUNT_ID=
R2_BUCKET_MEDIA=vaidyasala-media
R2_BUCKET_BACKUP=vaidyasala-backups
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=

# --- Worker ---
WORKER_CONCURRENCY=4
