FROM postgres:17-alpine

# Install pgvector
RUN apk add --no-cache \
    git \
    build-base \
    postgresql-dev \
    && git clone --branch v0.7.0 https://github.com/pgvector/pgvector.git /tmp/pgvector \
    && cd /tmp/pgvector \
    && make \
    && make install \
    && rm -rf /tmp/pgvector \
    && apk del git build-base postgresql-dev

# Initialize pgvector extension
COPY init-pgvector.sql /docker-entrypoint-initdb.d/01-pgvector.sql
