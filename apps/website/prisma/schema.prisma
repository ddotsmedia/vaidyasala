generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Video {
  id          String   @id @default(cuid())
  youtubeId   String   @unique
  title       String
  description String
  thumbnail   String
  duration    Int
  uploadDate  DateTime
  viewCount   Int      @default(0)
  category    String?
  doshaTarget String?
  tags        String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([doshaTarget])
}

model Article {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  content     String
  tags        String   @default("")
  published   Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
  @@index([published])
}

model Consultation {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String
  date      DateTime
  duration  Int
  topic     String?
  status    String   @default("pending")
  paymentId String?
  zoomLink  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
