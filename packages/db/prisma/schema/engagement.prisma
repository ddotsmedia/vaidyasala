// ───────────────────────── USERS & ENGAGEMENT (§2) ─────────────────────────
// Better Auth owns User/Session/Account/Verification/TwoFactor (see auth.prisma).

model Profile {
  id              String   @id // = Better Auth user id
  role            Role     @default(VIEWER)
  langPref        String   @default("ml")
  newsletterOptIn Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([role])
}

model WatchProgress {
  id          String   @id @default(cuid())
  viewerKey   String // "u:{userId}" | "a:{anonId}"
  userId      String?
  videoId     String
  positionSec Int // doubles as "resume at" — the player starts here
  /// Furthest point reached, 0-100. Kept separately from positionSec because a
  /// viewer who watches to the end then scrubs back still counts as 100%.
  watchedPercentage Int @default(0)
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([viewerKey, videoId])
  @@index([updatedAt])
  @@index([userId])
}

/// Like + bookmark for a viewer/video pair. Follows WatchProgress: keyed by the
/// same anonymous-or-user viewerKey with no FK to Video, so anonymous reactions
/// survive sign-in via the existing viewerKey merge.
model VideoReaction {
  id         String   @id @default(cuid())
  viewerKey  String
  userId     String?
  videoId    String
  liked      Boolean  @default(false)
  bookmarked Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([viewerKey, videoId])
  @@index([videoId])
  @@index([userId])
}

model AnalyticsEvent {
  id        BigInt   @id @default(autoincrement())
  name      String
  viewerKey String?
  videoId   String?
  props     Json
  createdAt DateTime @default(now())

  @@index([name, createdAt])
  @@index([videoId])
}

model Comment {
  id        String        @id @default(cuid())
  videoId   String
  userId    String
  body      String        @db.Text
  status    CommentStatus @default(PENDING)
  parentId  String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([videoId, status])
  @@index([status])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  status    String   @default("pending")
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NewsletterIssue {
  id        String    @id @default(cuid())
  subjectMl String
  bodyMd    String    @db.Text
  status    String    @default("draft")
  sentAt    DateTime?
  stats     Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// ───────────────────────── AYURVEDA FEATURES (§2) ─────────────────────────
/// Dosha assessment results: vata/pitta/kapha scores and dominant dosha.
model DoshaAssessment {
  id             String   @id @default(cuid())
  userId         String?  @unique
  vata           Int      @default(0)
  pitta          Int      @default(0)
  kapha          Int      @default(0)
  dominantDosha  String?  // "vata" | "pitta" | "kapha" | "dual" (for ties)
  submittedAt    DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
}

/// Daily wellness tracking: energy, digestion, mood, sleep quality.
model WellnessEntry {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @db.Date
  energy    Int?     // 1-10
  digestion Int?     // 1-10
  mood      Int?     // 1-10
  sleep     Int?     // 1-10
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
  @@index([date])
}

/// Historical dosha tracking: seasonal variations and trends.
model DoshaHistory {
  id            String   @id @default(cuid())
  userId        String
  doshaDate     DateTime @db.Date
  season        String?  // "spring" | "summer" | "autumn" | "winter"
  vata          Int?
  pitta         Int?
  kapha         Int?
  dominantDosha String?
  createdAt     DateTime @default(now())

  @@unique([userId, doshaDate])
  @@index([userId, doshaDate])
}

// ───────────────────────── SUBTITLES (§2) ─────────────────────────
/// Auto-generated subtitles via Deepgram for accessibility + SEO.
model Subtitle {
  id            String    @id @default(cuid())
  videoId       String    @unique
  language      String    @default("en")
  vtt           String?   @db.Text
  json          Json?     // Full transcript + word timings
  transcript    String?   @db.Text
  status        String    @default("pending") // "pending" | "processing" | "completed" | "failed"
  transcribedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([videoId])
  @@index([status])
}
